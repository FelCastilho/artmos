---
import "../styles/global.css";

import { getCollection } from "astro:content";

import Header from "../components/header/header.astro";
import FooterAstroComponent from "../components/footer/footer.astro";
import BluePlanetAstroComponent from "../components/planets/blue-planet/blue-planet.astro";


const planets = await getCollection("planets");

const orderedPlanets = planets.sort(
    (a, b) =>
        b.data.publishedAt.getTime() -
        a.data.publishedAt.getTime()
);

---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Artmos — um arquivo visual de mundos imaginários criados no SpaceEngine."
    />
    <title>Artmos — Mundos imaginários</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Oxygen:wght@700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Header />

    <main>
      <section class="hero">
        <div class="hero-glow hero-glow-blue"></div>
        <div class="hero-glow hero-glow-green"></div>

        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">
              <span></span>
              Arquivo de mundos imaginários
            </p>

            <h1>
              A <strong>art</strong>e de explorar o cos<strong>mos</strong>.
            </h1>

            <p class="hero-description">
              Uma coleção visual dedicada à exploração de mundos imaginários,
              transformando descobertas fictícias em registros contemplativos do
              cosmos.
            </p>

            <div class="hero-actions">
              <a class="button button-primary" href="#mundos">
                Explorar mundos →
              </a>

              <a class="button button-ghost" href="#sobre">
                Conhecer a Artmos
              </a>
            </div>

            <dl class="hero-stats">
              <div>
                <dt>24</dt>
                <dd>Mundos catalogados</dd>
              </div>

              <div>
                <dt>18</dt>
                <dd>Wallpapers disponíveis</dd>
              </div>

              <div>
                <dt>4K</dt>
                <dd>Resolução máxima</dd>
              </div>
            </dl>
          </div>

          <BluePlanetAstroComponent />
        </div>
      </section>

      <section class="section" id="mundos">
        <div class="container">
          <header class="section-heading">
            <div>
              <p class="eyebrow">
                <span></span>
                Descoberta em destaque
              </p>

              <h2>Um mundo entre o gelo e o oceano.</h2>
            </div>

            <p>
              Cada registro combina uma captura original, uma identidade própria
              e informações inspiradas na exploração.
            </p>
          </header>

          <article class="featured-world">
            <div class="featured-visual">
              <div class="featured-grid"></div>
              <div class="featured-planet"></div>

              <span class="featured-index">ART — 018</span>
              <span class="featured-location">Sistema Nyra</span>
            </div>

            <div class="featured-content">
              <div>
                <p class="overline">Mundo oceânico</p>

                <h3>Thalassa</h3>

                <p class="muted">
                  Uma esfera silenciosa coberta por oceanos profundos e
                  tempestades permanentes. Sua luz turquesa atravessa uma
                  atmosfera espessa.
                </p>
              </div>

              <dl class="world-data">
                <div>
                  <dt>Temperatura</dt>
                  <dd>−32 °C</dd>
                </div>

                <div>
                  <dt>Gravidade</dt>
                  <dd>0.94 G</dd>
                </div>

                <div>
                  <dt>Atmosfera</dt>
                  <dd>N₂ · CH₄</dd>
                </div>

                <div>
                  <dt>Distância</dt>
                  <dd>42.8 AL</dd>
                </div>
              </dl>

              <a class="text-link" href="/planets/thalassa">
                Abrir registro completo ↗
              </a>
            </div>
          </article>
        </div>
      </section>

      <section class="planet-section" id="planetas">
        <div class="planet-section__container">
          <header class="planet-section__header">
            <div>
              <p class="eyebrow"><span></span>Arquivo planetário</p>
              <h2>Mundos catalogados</h2>
            </div>
            <p class="planet-section__intro">
              Uma seleção de mundos encontrados no SpaceEngine, organizados por
              aparência, atmosfera e comportamento visual.
            </p>
          </header>

          <div class="planet-filters" aria-label="Filtros de planetas">
            <button class="planet-filter is-active" data-filter="all"
              >Todos <span>06</span></button
            >
            <button class="planet-filter" data-filter="satellite"
              >Satélite <span>02</span></button
            >
            <button class="planet-filter" data-filter="astreroid"
              >Asteróides <span>02</span></button
            >
            <button class="planet-filter" data-filter="planets"
              >Planetas <span>02</span></button
            >
            <button class="planet-filter" data-filter="stars"
              >Estrelas <span>02</span></button
            >
            <button class="planet-filter" data-filter="nebulae"
              >Nebulosas <span>02</span></button
            >
            <button class="planet-filter" data-filter="galaxy"
              >Galáxias <span>02</span></button
            >
            <button class="planet-filter" data-filter="black-hole"
              >Buracos negros <span>02</span></button
            >
          </div>

          <div class="planet-list">
    {
        orderedPlanets.map((planet, index) => (
            <article
                class:list={[
                    "planet-card",
                    index === 0 && "planet-card--large",
                ]}
                data-category={planet.data.category}
            >
                <a
                    href={`/planets/${planet.id}`}
                    class="planet-card__link"
                >
                    <div class="planet-card__image">
                        <img
                            src={planet.data.image}
                            alt={`Registro visual de ${planet.data.title}`}
                            class="planet-card__photo"
                        />

                        <span class="planet-card__code">
                            {planet.data.code}
                        </span>

                        <span class="planet-card__open">
                            Abrir registro ↗
                        </span>
                    </div>

                    <div class="planet-card__content">
                        <div>
                            <p class="planet-card__type">
                                {planet.data.type}
                            </p>

                            <h3>{planet.data.title}</h3>
                        </div>

                        <dl class="planet-card__data">
                            <div>
                                <dt>Distância</dt>
                                <dd>{planet.data.distance}</dd>
                            </div>

                            <div>
                                <dt>Temp.</dt>
                                <dd>{planet.data.temperature}</dd>
                            </div>
                        </dl>
                    </div>
                </a>
            </article>
        ))
    }
</div>

          <footer class="planet-section__footer">
            <p>06 mundos disponíveis no arquivo</p><a href="#"
              >Ver catálogo completo →</a>
          </footer>
        </div>
      </section>

      <section class="section wallpapers" id="wallpapers">
        <div class="container wallpapers-grid">
          <div>
            <p class="eyebrow light">
              <span></span>
              Wallpapers
            </p>

            <h2>Leve um novo mundo para sua tela.</h2>

            <p class="wallpapers-text">
              Imagens em alta resolução, preparadas para desktop e celular, sem
              marcas ou elementos sobrepostos.
            </p>

            <a class="button button-light" href="/wallpapers">
              Ver wallpapers →
            </a>
          </div>

          <div class="wallpaper-preview">
            <div class="screen screen-back">
              <div class="screen-planet green"></div>
            </div>

            <div class="screen screen-front">
              <div class="screen-planet blue"></div>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="journal">
        <div class="container">
          <header class="section-heading compact">
            <div>
              <p class="eyebrow">
                <span></span>
                Artmos Journal
              </p>

              <h2>Notas de exploração</h2>
            </div>

            <a class="text-link" href="/blog"> Ver artigos → </a>
          </header>

          <div class="article-list">
            <a class="article-row" href="/blog">
              <span>01</span>

              <div>
                <p>Bastidores</p>
                <h3>Como encontro mundos interessantes no SpaceEngine</h3>
              </div>

              <span>↗</span>
            </a>

            <a class="article-row" href="/blog">
              <span>02</span>

              <div>
                <p>Exploração</p>
                <h3>O que torna um planeta visualmente memorável?</h3>
              </div>

              <span>↗</span>
            </a>

            <a class="article-row" href="/blog">
              <span>03</span>

              <div>
                <p>Processo</p>
                <h3>Da descoberta ao wallpaper final</h3>
              </div>

              <span>↗</span>
            </a>
          </div>
        </div>
      </section>

      <section class="section about" id="sobre">
        <div class="container about-grid">
          <div>
            <p class="eyebrow">
              <span></span>
              Sobre a Artmos
            </p>

            <h2>Nem todos os mundos precisam existir para nos inspirar.</h2>
          </div>

          <div class="about-copy">
            <p>
              A Artmos é um projeto pessoal dedicado à exploração visual de
              mundos fictícios. Cada captura nasce no SpaceEngine e se
              transforma em uma pequena história.
            </p>

            <p>
              O objetivo é criar um arquivo contemplativo sobre lugares que
              poderiam existir em algum ponto do universo.
            </p>

            <a class="text-link" href="/about"> Conhecer o projeto → </a>
          </div>
        </div>
      </section>
    </main>

    <FooterAstroComponent />

    <script src="../scripts/catalog.js"></script>
  </body>
</html>
