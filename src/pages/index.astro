---
import "../styles/global.css";

const planets = [
  {
    name: "Nereida",
    type: "Mundo oceânico",
    meta: "Atmosfera densa · 0.91 G",
    color: "blue",
  },
  {
    name: "Orpheon",
    type: "Gigante gasoso",
    meta: "Sistema binário · 1.27 G",
    color: "violet",
  },
  {
    name: "Caelum",
    type: "Mundo temperado",
    meta: "Oceanos rasos · 0.84 G",
    color: "green",
  },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Artmos — um arquivo visual de mundos imaginários criados no SpaceEngine."
    />
    <title>Artmos — Mundos imaginários</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Oxygen:wght@700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="Artmos, página inicial">
          <span class="brand-symbol">A</span>
          <span>ARTMOS</span>
        </a>

        <nav class="site-nav" aria-label="Navegação principal">
          <a href="#mundos">Mundos</a>
          <a href="#wallpapers">Wallpapers</a>
          <a href="#journal">Journal</a>
          <a href="#sobre">Sobre</a>
        </nav>

        <a class="header-link" href="#mundos">Explorar ↗</a>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="hero-glow hero-glow-blue"></div>
        <div class="hero-glow hero-glow-green"></div>

        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">
              <span></span>
              Arquivo de mundos imaginários
            </p>

            <h1>
              Explore o que existe
              <strong>além do conhecido.</strong>
            </h1>

            <p class="hero-description">
              Uma coleção visual de planetas descobertos no SpaceEngine,
              acompanhados de histórias, dados e wallpapers.
            </p>

            <div class="hero-actions">
              <a class="button button-primary" href="#mundos">
                Explorar mundos →
              </a>

              <a class="button button-ghost" href="#sobre">
                Conhecer a Artmos
              </a>
            </div>

            <dl class="hero-stats">
              <div>
                <dt>24</dt>
                <dd>Mundos catalogados</dd>
              </div>

              <div>
                <dt>18</dt>
                <dd>Wallpapers disponíveis</dd>
              </div>

              <div>
                <dt>4K</dt>
                <dd>Resolução máxima</dd>
              </div>
            </dl>
          </div>

          <div
            class="hero-visual"
            aria-label="Representação de um planeta azul"
          >
            <div class="orbit orbit-outer"></div>
            <div class="orbit orbit-inner"></div>

            <div class="hero-planet">
              <div class="hero-planet-texture"></div>
              <div class="hero-planet-shadow"></div>
            </div>

            <div class="planet-label label-top">
              <span>COORDENADAS</span>
              <strong>RA 18H 42M</strong>
            </div>

            <div class="planet-label label-bottom">
              <span>DESIGNAÇÃO</span>
              <strong>ART-024</strong>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="mundos">
        <div class="container">
          <header class="section-heading">
            <div>
              <p class="eyebrow">
                <span></span>
                Descoberta em destaque
              </p>

              <h2>Um mundo entre o gelo e o oceano.</h2>
            </div>

            <p>
              Cada registro combina uma captura original, uma identidade própria
              e informações inspiradas na exploração.
            </p>
          </header>

          <article class="featured-world">
            <div class="featured-visual">
              <div class="featured-grid"></div>
              <div class="featured-planet"></div>

              <span class="featured-index">ART — 018</span>
              <span class="featured-location">Sistema Nyra</span>
            </div>

            <div class="featured-content">
              <div>
                <p class="overline">Mundo oceânico</p>

                <h3>Thalassa</h3>

                <p class="muted">
                  Uma esfera silenciosa coberta por oceanos profundos e
                  tempestades permanentes. Sua luz turquesa atravessa uma
                  atmosfera espessa.
                </p>
              </div>

              <dl class="world-data">
                <div>
                  <dt>Temperatura</dt>
                  <dd>−32 °C</dd>
                </div>

                <div>
                  <dt>Gravidade</dt>
                  <dd>0.94 G</dd>
                </div>

                <div>
                  <dt>Atmosfera</dt>
                  <dd>N₂ · CH₄</dd>
                </div>

                <div>
                  <dt>Distância</dt>
                  <dd>42.8 AL</dd>
                </div>
              </dl>

              <a class="text-link" href="/planets/thalassa">
                Abrir registro completo ↗
              </a>
            </div>
          </article>
        </div>
      </section>

      <section class="section catalog">
        <div class="container">
          <header class="section-heading compact">
            <div>
              <p class="eyebrow">
                <span></span>
                Arquivo recente
              </p>

              <h2>Outros mundos</h2>
            </div>

            <a class="text-link" href="/planets">
              Ver catálogo completo →
            </a>
          </header>

          <div class="planet-grid">
            {
              planets.map((planet, index) => (
                <article class="planet-card">
                  <a href={`/planets/${planet.name.toLowerCase()}`}>
                    <div class={`planet-card-image ${planet.color}`}>
                      <span class="card-number">
                        {String(index + 1).padStart(2, "0")}
                      </span>

                      <div class="card-planet"></div>
                    </div>

                    <div class="planet-card-content">
                      <div>
                        <p>{planet.type}</p>
                        <h3>{planet.name}</h3>
                      </div>

                      <span>↗</span>
                    </div>

                    <p class="card-meta">{planet.meta}</p>
                  </a>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section wallpapers" id="wallpapers">
        <div class="container wallpapers-grid">
          <div>
            <p class="eyebrow light">
              <span></span>
              Wallpapers
            </p>

            <h2>Leve um novo mundo para sua tela.</h2>

            <p class="wallpapers-text">
              Imagens em alta resolução, preparadas para desktop e celular,
              sem marcas ou elementos sobrepostos.
            </p>

            <a class="button button-light" href="/wallpapers">
              Ver wallpapers →
            </a>
          </div>

          <div class="wallpaper-preview">
            <div class="screen screen-back">
              <div class="screen-planet green"></div>
            </div>

            <div class="screen screen-front">
              <div class="screen-planet blue"></div>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="journal">
        <div class="container">
          <header class="section-heading compact">
            <div>
              <p class="eyebrow">
                <span></span>
                Artmos Journal
              </p>

              <h2>Notas de exploração</h2>
            </div>

            <a class="text-link" href="/blog">
              Ver artigos →
            </a>
          </header>

          <div class="article-list">
            <a class="article-row" href="/blog">
              <span>01</span>

              <div>
                <p>Bastidores</p>
                <h3>
                  Como encontro mundos interessantes no SpaceEngine
                </h3>
              </div>

              <span>↗</span>
            </a>

            <a class="article-row" href="/blog">
              <span>02</span>

              <div>
                <p>Exploração</p>
                <h3>
                  O que torna um planeta visualmente memorável?
                </h3>
              </div>

              <span>↗</span>
            </a>

            <a class="article-row" href="/blog">
              <span>03</span>

              <div>
                <p>Processo</p>
                <h3>
                  Da descoberta ao wallpaper final
                </h3>
              </div>

              <span>↗</span>
            </a>
          </div>
        </div>
      </section>

      <section class="section about" id="sobre">
        <div class="container about-grid">
          <div>
            <p class="eyebrow">
              <span></span>
              Sobre a Artmos
            </p>

            <h2>
              Nem todos os mundos precisam existir para nos inspirar.
            </h2>
          </div>

          <div class="about-copy">
            <p>
              A Artmos é um projeto pessoal dedicado à exploração visual de
              mundos fictícios. Cada captura nasce no SpaceEngine e se
              transforma em uma pequena história.
            </p>

            <p>
              O objetivo é criar um arquivo contemplativo sobre lugares que
              poderiam existir em algum ponto do universo.
            </p>

            <a class="text-link" href="/about">
              Conhecer o projeto →
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-top">
        <div>
          <a class="brand" href="/">
            <span class="brand-symbol">A</span>
            <span>ARTMOS</span>
          </a>

          <p>
            Explorando mundos inexistentes,<br />
            inspirando imaginações reais.
          </p>
        </div>

        <div class="footer-nav">
          <div>
            <strong>Explorar</strong>
            <a href="/planets">Mundos</a>
            <a href="/wallpapers">Wallpapers</a>
            <a href="/blog">Journal</a>
          </div>

          <div>
            <strong>Projeto</strong>
            <a href="/about">Sobre</a>
            <a href="/">Contato</a>
            <a href="/">Instagram</a>
          </div>
        </div>
      </div>

      <div class="container footer-bottom">
        <span>© 2026 Artmos</span>
        <span>Imagens criadas no SpaceEngine</span>
      </div>
    </footer>
  </body>
</html>