---
import "./style.css";
---

<div class="planet-stage">
  <div class="planet-stage__orbit planet-stage__orbit--outer"></div>
  <div class="planet-stage__orbit planet-stage__orbit--middle"></div>
  <div class="planet-stage__orbit planet-stage__orbit--inner"></div>

  <span class="planet-stage__orbit-dot planet-stage__orbit-dot--one"></span>
  <span class="planet-stage__orbit-dot planet-stage__orbit-dot--two"></span>

  <div class="planet-stage__coordinates">
    <span>RA 18h 36m 56s</span>
    <span>DEC +38° 47' 01"</span>
  </div>

  <div class="planet">
    <div class="planet__base"></div>
    <div class="planet__bands"></div>
    <div class="planet__ice"></div>
    <div class="planet__storm"></div>
    <div class="planet__glow"></div>
    <div class="planet__shadow"></div>
  </div>

  <div class="planet-stage__label">
    <span>ART—GLA-014</span>
    <strong>VEYRA</strong>
  </div>

  <div class="planet-stage__particles" aria-hidden="true"></div>
</div>
